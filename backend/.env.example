# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insurance_cold_calling

# Google Gemini (FREE - get key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (optional fallback - get key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional fallback - get key from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# SignalWire (FREE tier - signup at https://signalwire.com/signup)
SIGNALWIRE_SPACE=your_space_name.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id
SIGNALWIRE_AUTH_TOKEN=your_auth_token
SIGNALWIRE_PHONE_NUMBER=+1xxxxxxxxxx
SIGNALWIRE_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.dev

# ElevenLabs (FREE tier - get key from https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Whisper (runs locally - FREE, no API key needed)
WHISPER_MODEL=base

# JWT Secret - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your_jwt_secret_here

# Call Recording
CALL_RECORDING_ENABLED=true

# Sentry (optional - get DSN from https://sentry.io)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# App
DEBUG=false
ENVIRONMENT=development

# Redis (for Celery - optional, not needed for local dev)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
